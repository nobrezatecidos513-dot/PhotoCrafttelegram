import os
import logging
from io import BytesIO
from urllib.parse import quote, unquote

from PIL import Image, ImageEnhance, ImageFilter, ImageOps, ImageDraw, ImageFont
from aiogram import Bot, Dispatcher, executor, types
from aiogram.dispatcher.filters import Command
from aiogram.types import InlineKeyboardButton, InlineKeyboardMarkup
from dotenv import load_dotenv

logging.basicConfig(level=logging.INFO)
load_dotenv()

BOT_TOKEN = os.getenv("BOT_TOKEN")
DONATE_TON_ADDRESS = os.getenv("DONATE_TON_ADDRESS", "")
DONATE_KOFI = os.getenv("DONATE_KOFI", "")
DONATE_PAYPAL = os.getenv("DONATE_PAYPAL", "")
DONATE_GITHUB = os.getenv("DONATE_GITHUB", "")

if not BOT_TOKEN:
    raise ValueError("BOT_TOKEN não foi encontrado. Crie um arquivo .env com seu token do Telegram.")

bot = Bot(token=BOT_TOKEN)
dp = Dispatcher(bot)

FILTERS = {
    "bw": "Preto & Branco",
    "sepia": "Sépia",
    "contrast": "Contraste",
    "vintage": "Vintage",
    "warm": "Warm",
    "sharp": "Sharp",
    "bright": "Brilho",
    "cool": "Frio",
    "watermark": "Marca d'água",
    "soft": "Suave",
}


def sepia_tone(img: Image.Image) -> Image.Image:
    output = img.convert("RGB")
    pixels = output.load()
    width, height = output.size

    for y in range(height):
        for x in range(width):
            r, g, b = output.getpixel((x, y))
            tr = int(r * 0.94 + g * 0.77 + b * 0.35)
            tg = int(r * 0.76 + g * 0.68 + b * 0.28)
            tb = int(r * 0.56 + g * 0.48 + b * 0.22)
            pixels[x, y] = (min(255, tr), min(255, tg), min(255, tb))
    return output


def warm_tone(img: Image.Image) -> Image.Image:
    output = img.convert("RGB")
    pixels = output.load()
    width, height = output.size

    for y in range(height):
        for x in range(width):
            r, g, b = output.getpixel((x, y))
            pixels[x, y] = (min(255, r + 35), g, max(0, b - 15))
    return output


def cool_tone(img: Image.Image) -> Image.Image:
    output = img.convert("RGB")
    pixels = output.load()
    width, height = output.size

    for y in range(height):
        for x in range(width):
            r, g, b = output.getpixel((x, y))
            pixels[x, y] = (max(0, r - 25), g, min(255, b + 35))
    return output


def vintage_tone(img: Image.Image) -> Image.Image:
    grayscale = ImageOps.grayscale(img)
    grayscale = ImageEnhance.Contrast(grayscale).enhance(1.9)
    sepia = Image.new("RGB", grayscale.size, (120, 90, 60))
    return Image.blend(grayscale.convert("RGB"), sepia, 0.28)


def soft_tone(img: Image.Image) -> Image.Image:
    return img.filter(ImageFilter.SMOOTH)


def add_watermark(img: Image.Image, text: str = "PhotoCraft") -> Image.Image:
    output = img.convert("RGBA")
    width, height = output.size

    overlay = Image.new("RGBA", output.size, (0, 0, 0, 0))
    overlay_draw = ImageDraw.Draw(overlay)

    overlay_draw.rectangle((0, height - 110, width, height), fill=(0, 0, 0, 120))

    try:
        font = ImageFont.truetype("DejaVuSans-Bold.ttf", max(24, int(width / 20)))
    except Exception:
        font = ImageFont.load_default()

    text_bbox = overlay_draw.textbbox((0, 0), text, font=font)
    text_width = text_bbox[2] - text_bbox[0]
    text_height = text_bbox[3] - text_bbox[1]

    position = ((width - text_width) // 2, height - 70)
    overlay_draw.text(position, text, font=font, fill=(255, 255, 255, 220))

    output = Image.alpha_composite(output, overlay)
    return output.convert("RGB")


def apply_filter(img: Image.Image, filter_name: str) -> Image.Image:
    img = img.convert("RGB")

    if filter_name == "bw":
        return ImageOps.grayscale(img)

    if filter_name == "sepia":
        return sepia_tone(img)

    if filter_name == "contrast":
        return ImageEnhance.Contrast(img).enhance(2.2)

    if filter_name == "vintage":
        return vintage_tone(img)

    if filter_name == "warm":
        return warm_tone(img)

    if filter_name == "sharp":
        return img.filter(ImageFilter.SHARPEN)

    if filter_name == "bright":
        return ImageEnhance.Brightness(img).enhance(1.35)

    if filter_name == "cool":
        return cool_tone(img)

    if filter_name == "soft":
        return soft_tone(img)

    if filter_name == "watermark":
        return add_watermark(img, "PhotoCraft")

    return img


def build_filter_keyboard(file_id: str) -> InlineKeyboardMarkup:
    keyboard = InlineKeyboardMarkup(row_width=2)
    for key, label in FILTERS.items():
        callback_data = f"filter:{quote(file_id)}:{key}"
        keyboard.insert(InlineKeyboardButton(label, callback_data=callback_data))
    return keyboard


def build_donation_keyboard() -> InlineKeyboardMarkup:
    keyboard = InlineKeyboardMarkup(row_width=1)
    if DONATE_TON_ADDRESS:
        keyboard.add(InlineKeyboardButton("Doar via TON (Gram)", url=f"https://ton.org/transfer?address={DONATE_TON_ADDRESS}"))
    if DONATE_KOFI:
        keyboard.add(InlineKeyboardButton("Ko-fi", url=DONATE_KOFI))
    if DONATE_PAYPAL:
        keyboard.add(InlineKeyboardButton("PayPal", url=DONATE_PAYPAL))
    if DONATE_GITHUB:
        keyboard.add(InlineKeyboardButton("GitHub Sponsors", url=DONATE_GITHUB))
    return keyboard


@dp.message_handler(Command("start"))
async def cmd_start(message: types.Message):
    await message.answer(
        "Bem-vindo ao PhotoCraft Telegram!\n\n"
        "Envie uma foto e escolha um filtro para aplicar.\n\n"
        "Comandos disponíveis:\n"
        "/start - iniciar\n"
        "/help - ajuda\n"
        "/menu - mostrar filtros\n"
        "/donate - apoio opcional"
    )


@dp.message_handler(Command("help"))
async def cmd_help(message: types.Message):
    await message.answer(
        "Como usar:\n"
        "1. Envie uma foto para o bot\n"
        "2. Escolha um filtro\n"
        "3. Receba a imagem editada no chat\n\n"
        "O apoio é opcional e você pode usar o bot sem doar."
    )


@dp.message_handler(Command("menu"))
async def cmd_menu(message: types.Message):
    keyboard = InlineKeyboardMarkup(row_width=2)
    for key, label in FILTERS.items():
        keyboard.insert(InlineKeyboardButton(label, callback_data=f"menu:{key}"))

    await message.answer("Escolha um filtro:", reply_markup=keyboard)


@dp.message_handler(Command("donate"))
async def cmd_donate(message: types.Message):
    keyboard = build_donation_keyboard()
    if not keyboard.inline_keyboard:
        await message.answer(
            "Você pode apoiar o projeto via doações opcionais.\n"
            "Agora ainda não há links configurados, mas você pode adicionar os valores em .env."
        )
        return

    await message.answer(
        "Se você quiser apoiar o PhotoCraft, isso é totalmente opcional.\n"
        "Obrigado por usar o bot!",
        reply_markup=keyboard,
    )


@dp.message_handler(content_types=['photo'])
async def handle_photo(message: types.Message):
    photo = message.photo[-1]
    await message.answer_photo(
        photo.file_id,
        caption="Escolha um efeito para sua imagem:",
        reply_markup=build_filter_keyboard(photo.file_id),
    )


@dp.callback_query_handler(lambda c: c.data.startswith("menu:"))
async def handle_menu_callback(callback_query: types.CallbackQuery):
    _, filter_name = callback_query.data.split(":", 1)
    await bot.answer_callback_query(
        callback_query.id,
        text=f"Filtro selecionado: {FILTERS[filter_name]}",
        show_alert=False,
    )


@dp.callback_query_handler(lambda c: c.data.startswith("filter:"))
async def handle_filter_callback(callback_query: types.CallbackQuery):
    _, encoded_file_id, filter_name = callback_query.data.split(":", 2)
    file_id = unquote(encoded_file_id)

    await bot.answer_callback_query(
        callback_query.id,
        text=f"Aplicando filtro: {FILTERS[filter_name]}",
        show_alert=False,
    )

    try:
        file = await bot.get_file(file_id)
        file_bytes = await bot.download_file(file.file_path)
        img = Image.open(BytesIO(file_bytes)).convert("RGB")
        processed = apply_filter(img, filter_name)

        output = BytesIO()
        processed.save(output, format="JPEG", quality=92)
        output.seek(0)

        await callback_query.message.reply_photo(
            types.InputFile(output, filename=f"photo_craft_{filter_name}.jpg"),
            caption=f"✨ Efeito aplicado: {FILTERS[filter_name]}",
        )
    except Exception:
        logging.exception("Erro ao processar imagem")
        await callback_query.message.reply(
            "Não foi possível processar a imagem. Tente novamente com outra foto."
        )


if __name__ == "__main__":
    executor.start_polling(dp, skip_updates=True)
